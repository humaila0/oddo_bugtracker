<odoo>
    <data>

        <record id="view_bug_tracker_tree" model="ir.ui.view">
            <field name="name">bug.tracker.list</field>
            <field name="model">bug.tracker</field>
            <field name="arch" type="xml">
                <list string="Bugs">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="developer_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_bug_tracker_form" model="ir.ui.view">
            <field name="name">bug.tracker.form</field>
            <field name="model">bug.tracker</field>
            <field name="arch" type="xml">
                <form string="Bug">
                    <header>

                        <button name="action_assign"
                                string="Assign"
                                type="object"
                                invisible="state != 'new'"/>

                        <button name="action_start"
                                string="Start Progress"
                                type="object"
                                invisible="state != 'assigned'"/>

                        <button name="action_done"
                                string="Mark Done"
                                type="object"
                                invisible="state != 'progress'"/>

                        <button name="action_close"
                                string="Close"
                                type="object"
                                invisible="state != 'done'"/>

                        <field name="state"
                               widget="statusbar"
                               statusbar_visible="new,assigned,progress,done,closed"/>
                    </header>

                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="developer_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>

                        <notebook>

                            <page string="Description">
                                <field name="description"/>
                            </page>

                            <page string="Comments">
                                <field name="comment_ids">
                                    <list editable="bottom">
                                        <field name="user_id"/>
                                        <field name="comment"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bug_tracker" model="ir.actions.act_window">
            <field name="name">Bugs</field>
            <field name="res_model">bug.tracker</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_bug_root"
                  name="Bug Tracker"
                  sequence="10"/>

        <menuitem id="menu_bug_tracker"
                  name="Bugs"
                  parent="menu_bug_root"
                  action="action_bug_tracker"
                  sequence="10"/>

    </data>
</odoo>
